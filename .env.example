# CivicAI Environment Variables Configuration
# Copy this file to .env and configure your local settings

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civicai_db
DB_USERNAME=root
DB_PASSWORD=Sandy@118
DB_URL=jdbc:mysql://localhost:3306/civicai_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Spring Boot Configuration
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Upload Paths
UPLOAD_DIR=../uploads

# Python AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1

# Hugging Face AI Models Configuration (CPU Optimized)
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_VISION_MODEL=google/mobilenet_v2_1.0_224
HF_WHISPER_MODEL=openai/whisper-tiny
HF_MULTILINGUAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_OCR_MODEL=RapidOCR
AI_DEVICE=cpu
ENABLE_HF_VISION=true
ENABLE_HF_SPEECH=true
ENABLE_HF_OCR=true
ENABLE_ML_PRIORITY=true
ENABLE_GEMINI=false

# Optional Cloud LLM Configuration (Local offline synthesizer active by default)
LLM_PROVIDER=offline
OPENAI_API_KEY=
GEMINI_API_KEY=
