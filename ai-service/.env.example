# CivicAI AI Service (FastAPI) Configuration
AI_PORT=8000
AI_HOST=127.0.0.1
BACKEND_API_URL=http://localhost:8080/api

# Zero-budget local execution:
# 'offline' runs Sentence Transformers + FAISS + Rule-based Agentic fallback.
# Set to 'gemini' or 'openai' only if you choose to configure an optional API key.
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local paths
DOCUMENTS_DIR=../../uploads/documents
EVIDENCE_DIR=../../uploads/evidence
FAISS_STORAGE_PATH=./faiss_index
